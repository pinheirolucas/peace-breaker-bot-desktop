{
  "name": "peace-breaker-bot-desktop",
  "productName": "Peace Breaker Bot",
  "version": "0.1.12",
  "author": "pinheirolucas",
  "main": "build/electron.js",
  "homepage": "./",
  "repository": "github:pinheirolucas/peace-breaker-bot-desktop",
  "build": {
    "productName": "Peace Breaker Bot",
    "artifactName": "Peace.Breaker.Bot-${version}-${arch}.${ext}",
    "publish": {
      "provider": "github"
    },
    "directories": {
      "buildResources": "resources"
    },
    "files": [
      "build/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "extraMetadata": {
      "main": "build/electron.js"
    },
    "afterPack": "scripts/afterPack.cjs",
    "mac": {
      "identity": "Peace Breaker Bot Code Signing",
      "icon": "resources/icon.icns",
      "extendInfo": {
        "NSLocalNetworkUsageDescription": "Peace Breaker Bot looks for the bot server on your local network via Bonjour.",
        "NSBonjourServices": [
          "_myinstants._tcp."
        ]
      }
    },
    "win": {
      "icon": "resources/icon.ico",
      "artifactName": "Peace.Breaker.Bot.Setup.${version}.${ext}"
    },
    "linux": {
      "icon": "resources/icons",
      "target": [
        "AppImage"
      ]
    }
  },
  "private": true,
  "dependencies": {
    "@fontsource-variable/archivo": "^5.2.5",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toast": "^1.2.23",
    "@radix-ui/react-tooltip": "^1.2.16",
    "bonjour-service": "1.4.4",
    "electron-updater": "^6.8.9",
    "i18next": "^26.4.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-dropzone": "^20.1.1",
    "react-i18next": "^17.0.13"
  },
  "scripts": {
    "react-start": "vite",
    "react-build": "vite build",
    "react-test": "vitest",
    "typecheck": "tsc --noEmit",
    "electron-compile": "tsup",
    "electron-watch": "tsup --watch",
    "electron-build": "electron-builder",
    "release": "pnpm react-build && pnpm electron-compile && electron-builder --publish=always",
    "build": "pnpm react-build && pnpm electron-compile && pnpm electron-build",
    "start": "concurrently \"pnpm react-start\" \"pnpm electron-watch\" \"wait-on http://localhost:3000 build/electron.js && electron .\"",
    "storybook": "storybook dev -p 6006 --no-open",
    "icons": "node scripts/build-icons.mts"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/react-vite": "^10.6.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.7.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "electron": "^44.2.0",
    "electron-builder": "^26.16.1",
    "jsdom": "^30.0.1",
    "msw": "2.15.0",
    "sharp": "^0.35.4",
    "storybook": "^10.6.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "vitest": "^5.0.0",
    "wait-on": "^9.1.0"
  }
}
