{
  "name": "peace-breaker-bot-desktop",
  "productName": "Peace Breaker Bot",
  "version": "0.2.0",
  "author": "pinheirolucas",
  "main": "build/electron.js",
  "homepage": "./",
  "repository": "github:pinheirolucas/peace-breaker-bot-desktop",
  "build": {
    "productName": "Peace Breaker Bot",
    "artifactName": "Peace.Breaker.Bot-${version}-${arch}.${ext}",
    "publish": {
      "provider": "github"
    },
    "directories": {
      "buildResources": "resources"
    },
    "files": [
      "build/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "extraMetadata": {
      "main": "build/electron.js"
    },
    "afterPack": "scripts/afterPack.cjs",
    "mac": {
      "identity": "Peace Breaker Bot Code Signing",
      "icon": "resources/icon.icns",
      "extendInfo": {
        "NSLocalNetworkUsageDescription": "Peace Breaker Bot looks for the bot server on your local network via Bonjour.",
        "NSBonjourServices": [
          "_myinstants._tcp."
        ]
      }
    },
    "win": {
      "icon": "resources/icon.ico",
      "artifactName": "Peace.Breaker.Bot.Setup.${version}.${ext}"
    },
    "linux": {
      "icon": "resources/icons",
      "target": [
        "AppImage"
      ],
      "desktop": {
        "entry": {
          "Actions": "OpenQuickAccess;Stop;Refresh;"
        },
        "desktopActions": {
          "OpenQuickAccess": {
            "Name": "Open Quick Access",
            "Name[pt_BR]": "Abrir acesso rápido",
            "Exec": "peace-breaker-bot-desktop --action=open-quick-access"
          },
          "Stop": {
            "Name": "Stop Playback",
            "Name[pt_BR]": "Parar reprodução",
            "Exec": "peace-breaker-bot-desktop --action=stop"
          },
          "Refresh": {
            "Name": "Search for Server Again",
            "Name[pt_BR]": "Procurar servidor novamente",
            "Exec": "peace-breaker-bot-desktop --action=refresh"
          }
        }
      }
    }
  },
  "private": true,
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/archivo": "^5.3.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-radio-group": "^1.5.1",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-toast": "^1.3.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "bonjour-service": "1.4.4",
    "electron-updater": "^6.8.11",
    "i18next": "^26.5.11",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-dropzone": "^20.1.4",
    "react-i18next": "^17.1.9"
  },
  "scripts": {
    "react-start": "vite",
    "react-build": "vite build",
    "react-test": "vitest",
    "typecheck": "tsc --noEmit",
    "electron-compile": "tsup",
    "electron-watch": "tsup --watch",
    "electron-build": "electron-builder",
    "release": "pnpm react-build && pnpm electron-compile && electron-builder --publish=always",
    "build": "pnpm react-build && pnpm electron-compile && pnpm electron-build",
    "start": "concurrently \"pnpm react-start\" \"pnpm electron-watch\" \"wait-on http://localhost:3000 build/electron.js && electron .\"",
    "storybook": "storybook dev -p 6006 --no-open",
    "icons": "node scripts/build-icons.mts"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.6.5",
    "@storybook/addon-docs": "^10.6.5",
    "@storybook/react-vite": "^10.6.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "jsdom": "^30.1.3",
    "msw": "^3.0.3",
    "sharp": "^0.35.5",
    "storybook": "^10.6.5",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wait-on": "^9.5.1"
  }
}
